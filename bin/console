#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Console\Application;
use App\Console\Command;
use App\Kernel;

if (PHP_SAPI !== 'cli') {
    exit(1);
}

$core = dirname(__DIR__);
require $core . '/vendor/autoload.php';

// Which store to run for. Stores share this core (their core/ link points here) but each has its own
// .env, database and var/, so a command must be told which one: STORE_ROOT=/var/www/stores/shop,
// or run it from inside the store's folder (the one holding .env and the core/ link). With neither,
// the core itself is the store (single-store installs).
$root = $core;
$requested = getenv('STORE_ROOT') ?: getcwd();
if (is_string($requested) && $requested !== '' && realpath($requested) !== $core
    && is_file($requested . '/.env') && is_dir($requested . '/core/src') && realpath($requested . '/core') === $core) {
    $root = realpath($requested);
}

$kernel = Kernel::boot($root);

exit((new Application($kernel->container(), [
    Command\AddImageCommand::class,
    Command\AdminUnlockCommand::class,
    Command\AdminUserCommand::class,
    Command\BackupDatabaseCommand::class,
    Command\CheckImageCommand::class,
    Command\ExpireOrdersCommand::class,
    Command\ExportProductsCommand::class,
    Command\HashPasswordCommand::class,
    Command\ImportProductsCommand::class,
    Command\MigrateDatabaseCommand::class,
    Command\ProcessMailQueueCommand::class,
    Command\NotifyStockCommand::class,
    Command\PruneCommand::class,
    Command\RegenerateImagesCommand::class,
    Command\RemindCartsCommand::class,
    Command\ReimportDatabaseCommand::class,
    Command\UpdateCurrencyRatesCommand::class,
    Command\RestoreDatabaseCommand::class,
]))->run($_SERVER['argv'] ?? []));
