# Defense in depth: this file only matters if the vhost's DocumentRoot is
# ever pointed at the project root instead of public/. It blocks direct
# access to everything here (.env, vendor/, src/, database/, commands/,
# var/, the cert directory, etc). The real DocumentRoot should be public/.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
