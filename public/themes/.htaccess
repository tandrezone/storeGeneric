# Theme templates are rendered by the app, never served directly. Themes can't
# contain PHP (the installer skips it), but deny it here too, uploaded themes included.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar|php\d|pht|phps|twig)$">
        Require all denied
    </FilesMatch>
    # Also "x.php.css" and friends, which AddHandler-style setups may execute.
    <FilesMatch "\.(php\d*|phtml|phar|pht|phps|cgi|pl|py|sh)\.">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar|php\d|pht|phps|twig)$">
        Order deny,allow
        Deny from all
    </FilesMatch>
    <FilesMatch "\.(php\d*|phtml|phar|pht|phps|cgi|pl|py|sh)\.">
        Order deny,allow
        Deny from all
    </FilesMatch>
</IfModule>

# Never hand anything in here to a script handler, whatever its name.
<IfModule mod_mime.c>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .pht .phps .cgi .pl .py .sh
    RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .pht .phps
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php5.c>
    php_flag engine off
</IfModule>
Options -ExecCGI

# Uploaded SVGs could carry scripts; never let them run when opened directly.
<IfModule mod_headers.c>
    <FilesMatch "\.svg$">
        Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:"
    </FilesMatch>
</IfModule>
