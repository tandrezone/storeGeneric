# Theme templates are rendered by the app, never served directly. Themes can't
# contain PHP (the installer skips it), but deny it here too, uploaded themes included.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar|php\d|twig)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar|php\d|twig)$">
        Order deny,allow
        Deny from all
    </FilesMatch>
</IfModule>

# Uploaded SVGs could carry scripts; never let them run when opened directly.
<IfModule mod_headers.c>
    <FilesMatch "\.svg$">
        Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:"
    </FilesMatch>
</IfModule>
