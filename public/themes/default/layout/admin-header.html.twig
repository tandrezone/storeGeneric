{#
  Admin header. Extra variables: active_nav, csrf_token,
  admin_nav (list of {key, label, url, active}).
  Keep the csrf-token meta tag and data-layout="admin" — admin scripts rely on them.
#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="csrf-token" content="{{ csrf_token }}">
<title>{{ page_title }}</title>
{% include 'partials/icons.html.twig' %}
<link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>
<body data-layout="admin">
<header class="site-header">
    <div class="container header-inner">
        <a href="{{ path('admin.products') }}" class="logo">{{ logo() }} <span class="admin-tag">Admin</span></a>
        <nav class="main-nav">
            {% for item in admin_nav %}
                <a href="{{ item.url }}" class="{{ item.active ? 'active' : '' }}">{{ item.label }}</a>
            {% endfor %}
            <a href="{{ path('admin.logout') }}" data-no-ajax>Log out</a>
        </nav>
    </div>
</header>
<main class="container">
