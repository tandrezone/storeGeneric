{# Storefront footer — closes what header.html.twig opened. Keep the two scripts.
   languages: [{code, name, html_lang, url, active}] — the language switcher (see header).
   footer_pages: [{title, url}] — extra links from Admin → Pages (may be missing in old themes). #}
</main>
<footer class="site-footer">
    <div class="container footer-inner">
        <nav class="footer-nav" aria-label="{{ 'Footer'|trans }}">
            <a href="{{ path('page.about') }}">{{ 'About Us'|trans }}</a>
            <a href="{{ path('page.info') }}">{{ 'Info'|trans }}</a>
            <a href="{{ path('page.support') }}">{{ 'Support'|trans }}</a>
            <a href="{{ path('order.track') }}">{{ 'Track your order'|trans }}</a>
            <a href="{{ path('page.terms') }}">{{ 'Terms & Conditions'|trans }}</a>
            <a href="{{ path('page.privacy') }}">{{ 'Privacy Policy'|trans }}</a>
            {% for page in footer_pages|default([]) %}<a href="{{ page.url }}">{{ page.title }}</a>{% endfor %}
        </nav>
        {% if languages|default([])|length > 1 %}
            <nav class="footer-lang" aria-label="{{ 'Language'|trans }}">
                {% for language in languages %}
                    <a href="{{ language.url }}" hreflang="{{ language.html_lang }}" lang="{{ language.html_lang }}" data-no-ajax{% if language.active %} aria-current="true" class="active"{% endif %}>{{ language.name }}</a>
                {% endfor %}
            </nav>
        {% endif %}
        <p>&copy; {{ year }} {{ store.name }}. {{ 'All rights reserved.'|trans }}</p>
    </div>
</footer>
<script src="/assets/js/ajax-nav.js"></script>
<script src="/assets/js/app.js"></script>
<script src="{{ asset('js/responsive-tables.js') }}" defer></script>
</body>
</html>
