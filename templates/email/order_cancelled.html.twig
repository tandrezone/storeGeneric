{% extends 'email/_layout.html.twig' %}

{% block body %}
<p>{{ 'Hi {name},'|trans({name: order.ship_name}) }}</p>
{% if refunded %}
    <p>{{ 'Your order {number} has been refunded. The amount of {total} goes back to your original payment method ({method}); depending on your bank this can take a few days to show.'|trans({number: '<strong>' ~ order.order_number|e ~ '</strong>', total: '<strong>' ~ order.total|money|e ~ '</strong>', method: payment_label|e})|raw }}</p>
{% else %}
    <p>{{ 'Your order {number} has been cancelled. Nothing was charged for it.'|trans({number: '<strong>' ~ order.order_number|e ~ '</strong>'})|raw }}</p>
{% endif %}
{{ include('email/_items.html.twig') }}
<p>{{ 'If you have any questions, just reply to this email.'|trans }}</p>
{% endblock %}
