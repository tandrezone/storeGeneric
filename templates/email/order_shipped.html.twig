{% extends 'email/_layout.html.twig' %}

{% block body %}
<p>Hi {{ order.ship_name }},</p>
<p>Good news — your order <strong>{{ order.order_number }}</strong> is on its way{% if order.carrier %} with <strong>{{ order.carrier }}</strong>{% endif %}.</p>
{% if order.tracking_number %}
    <p>Tracking number: <strong>{{ order.tracking_number }}</strong></p>
{% endif %}
{{ include('email/_address.html.twig') }}
{{ include('email/_items.html.twig') }}
<p><a href="{{ order_url }}" style="display:inline-block;background:#111827;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;">Track your order</a></p>
{% endblock %}
