{% extends 'email/_layout.html.twig' %}

{% block body %}
<p>{{ 'A customer asked to return items of order {number}.'|trans({number: '<strong>' ~ request.order_number|e ~ '</strong>'})|raw }}</p>
<p><strong>{{ request.ship_name }}</strong> ({{ request.email }})<br>{{ 'Reason'|trans }}: {{ reasons[request.reason]|default(request.reason)|trans }}</p>
<ul>{% for item in request['items'] %}<li>{{ item.product_name }}{% if (item.label ~ ' ' ~ item.unit)|trim %} — {{ (item.label ~ ' ' ~ item.unit)|trim }}{% endif %} &times; {{ item.quantity }}</li>{% endfor %}</ul>
{% if request.details %}<p>{{ request.details|nl2br }}</p>{% endif %}
<p><a href="{{ admin_url }}" style="display:inline-block;background:#111827;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;">{{ 'Review return requests'|trans }}</a></p>
{% endblock %}
