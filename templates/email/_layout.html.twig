{# Base layout for HTML emails: inline styles only, since mail clients ignore stylesheets. #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ store_name }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f5;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f5;padding:24px 12px;">
    <tr><td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:8px;padding:24px;">
            <tr><td style="font-size:20px;font-weight:bold;padding-bottom:16px;">{{ store_name }}</td></tr>
            <tr><td style="font-size:15px;line-height:1.5;">
                {% block body %}{% endblock %}
            </td></tr>
            <tr><td style="font-size:12px;color:#6b7280;padding-top:24px;border-top:1px solid #e5e7eb;">
                Questions? Reply to this email or write to <a href="mailto:{{ store_email }}" style="color:#6b7280;">{{ store_email }}</a>.
            </td></tr>
        </table>
    </td></tr>
</table>
</body>
</html>
