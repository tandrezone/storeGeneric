{% extends 'email/_layout.html.twig' %}

{% block body %}
<p>Hi {{ name }},</p>
<p>Someone (hopefully you) asked to reset the password of your {{ store_name }} account. Choose a new password here:</p>
<p><a href="{{ reset_url }}" style="display:inline-block;background:#111827;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;">Choose a new password</a></p>
<p style="font-size:13px;color:#6b7280;">Or copy this link into your browser: {{ reset_url }}</p>
<p>The link works once and expires in {{ minutes }} minutes.</p>
<p style="font-size:13px;color:#6b7280;">Didn't ask for this? Ignore this email — your password stays the same.</p>
{% endblock %}
