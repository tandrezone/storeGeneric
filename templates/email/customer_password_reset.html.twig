{% extends 'email/_layout.html.twig' %}

{% block body %}
<p>{{ 'Hi {name},'|trans({name: name}) }}</p>
<p>{{ 'Someone (hopefully you) asked to reset the password of your {store} account.'|trans({store: store_name}) }} {{ 'Choose a new password here:'|trans }}</p>
<p><a href="{{ reset_url }}" style="display:inline-block;background:#111827;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;">{{ 'Choose a new password'|trans }}</a></p>
<p style="font-size:13px;color:#6b7280;">{{ 'Or copy this link into your browser: {url}'|trans({url: reset_url}) }}</p>
<p>{{ 'The link works once and expires in {count} minutes.'|trans_plural(minutes) }}</p>
<p style="font-size:13px;color:#6b7280;">{{ 'Didn\'t ask for this? Ignore this email — your password stays the same.'|trans }}</p>
{% endblock %}
