{% extends 'email/_layout.html.twig' %}

{% block body %}
<p>{{ 'New order {number} — {total}, {method} (payment: {status}).'|trans({number: '<strong>' ~ order.order_number|e ~ '</strong>', total: order.total|money|e, method: payment_label|e, status: order.payment_status|capitalize|trans|e})|raw }}</p>
<p style="font-size:14px;">{{ 'Customer'|trans }}: {{ order.ship_name }} &lt;{{ order.email }}&gt;{% if order.phone %}, {{ order.phone }}{% endif %}</p>
{{ include('email/_items.html.twig') }}
{{ include('email/_address.html.twig') }}
<p><a href="{{ admin_url }}">{{ 'Open the order in the admin'|trans }}</a></p>
{% endblock %}
