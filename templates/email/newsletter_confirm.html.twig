{% extends 'email/_layout.html.twig' %}

{% block body %}
<p>{{ 'Please confirm that you want to receive our newsletter.'|trans }}</p>
<p><a href="{{ confirm_url }}" style="display:inline-block;background:#111827;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;">{{ 'Confirm subscription'|trans }}</a></p>
<p style="font-size:12px;color:#6b7280;">{{ 'If you did not ask for this, just ignore this email — you will not be subscribed.'|trans }}</p>
{% endblock %}
