{#
  Product card for listings (shop home, related products).
  product: a ProductRepository listing row (id, name, image_path, from_price, stock, …)
  eager:   true for the first cards on screen (no lazy loading)
#}
{% set image = product.image_path ? image_size(product.image_path) : null %}
{% set sold_out = product.from_price is null or product.stock <= 0 %}
<a class="product-card{{ sold_out ? ' is-sold-out' }}" href="{{ product_url(product) }}">
    <div class="product-card-image">
        {% if image %}
            <img src="{{ thumb(product.image_path, 400) }}"
                 srcset="{{ srcset(product.image_path) }}"
                 sizes="(max-width: 520px) 100vw, (max-width: 1100px) 50vw, 260px"
                 width="{{ image.width }}" height="{{ image.height }}"
                 alt="{{ product.name }}"
                 {% if eager|default(false) %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
        {% else %}
            <div class="image-placeholder">No image</div>
        {% endif %}
        {% if sold_out %}
            <span class="stock-badge is-out">Out of stock</span>
        {% elseif product.stock <= low_stock_threshold %}
            <span class="stock-badge is-low">Only {{ product.stock }} left</span>
        {% endif %}
    </div>
    <div class="product-card-body">
        <span class="category-badge">{{ product.category_name }}</span>
        <h3>{{ product.name }}</h3>
        <p class="short-desc">{{ product.short_description }}</p>
        {% if product.from_price is not null %}
            <p class="price">From {{ product.from_price|money }}</p>
        {% endif %}
    </div>
</a>
