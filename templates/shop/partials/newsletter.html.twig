{# Newsletter signup, shown at the end of every storefront page when it is switched on (Admin → Newsletter). #}
<section class="footer-newsletter container" aria-labelledby="newsletter-heading">
    <h2 id="newsletter-heading" style="font-size: 1.1rem;">{{ 'Newsletter'|trans }}</h2>
    <form method="post" action="{{ path('newsletter.subscribe') }}" class="inline-signup" data-no-ajax>
        {{ csrf_field() }}
        <input type="hidden" name="back" value="{{ current_path|default('/') }}">
        <label for="newsletter-email" class="visually-hidden">{{ 'Email'|trans }}</label>
        <input type="email" id="newsletter-email" name="email" required placeholder="{{ 'Your email'|trans }}" autocomplete="email">
        <input type="text" name="website" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">
        <button type="submit" class="btn-secondary">{{ 'Subscribe'|trans }}</button>
    </form>
</section>
