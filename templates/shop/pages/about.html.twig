{% extends 'layout/shop.html.twig' %}

{% set title = 'About Us'|trans %}

{% block content %}
<section class="content-page">
    <h1>{{ 'About Us'|trans }}</h1>
    <p class="page-subtitle">{{ 'Who we are and how we work.'|trans }}</p>

    <h2>{{ 'Who we are'|trans }}</h2>
    <p>
        {{ '{store} is an independent online shop. Replace this paragraph with your own story: what you sell, why you started, and what customers can expect from you.'|trans({store: store.name}) }}
    </p>

    <h2>{{ 'How we work'|trans }}</h2>
    <p>
        {{ 'Every product is reviewed before it appears in the shop. Shipping options and their prices are listed at checkout, and you choose how to pay from the payment methods we accept.'|trans }}
    </p>

    <h2>{{ 'Our approach to service'|trans }}</h2>
    <p>
        {{ 'Orders are tracked from the moment you check out to the moment they\'re marked delivered, and you can always look one up with your order number and email — see {info} for how that works. If anything about an order looks wrong, {support} is the fastest way to reach us.'|trans({
            info: '<a href="' ~ path('page.info')|e ~ '">' ~ 'Info'|trans|e ~ '</a>',
            support: '<a href="' ~ path('page.support')|e ~ '">' ~ 'Support'|trans|e ~ '</a>',
        })|raw }}
    </p>

    <p class="updated-note">{{ 'Last updated August 2026.'|trans }}</p>
</section>
{% endblock %}
