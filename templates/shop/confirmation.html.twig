{% extends 'layout/shop.html.twig' %}

{% set title = 'Order Confirmation'|trans %}

{% block content %}
<section class="confirmation-page">
    {% if order %}
        {% if order.status == 'cancelled' %}
            <h1>{{ 'This order was cancelled.'|trans }}</h1>
            <p>{{ 'The payment didn\'t go through, so nothing was charged. You\'re welcome to place the order again.'|trans }}</p>
        {% else %}
            <h1>{{ 'Thank you, your order is on its way to being processed.'|trans }}</h1>
            {% if order.payment_status == 'paid' %}
                <p>{{ 'Your payment is confirmed. A confirmation has been sent to {email}.'|trans({email: order.email}) }}</p>
            {% else %}
                <p>{{ 'A confirmation will be sent to {email} once payment is confirmed.'|trans({email: order.email}) }}</p>
            {% endif %}
        {% endif %}

        {% if payment_instructions and order.payment_status not in ['paid', 'refunded'] and order.status != 'cancelled' %}
            <div class="panel payment-instructions">{{ payment_instructions|raw }}</div>
        {% elseif order.payment_status in ['unpaid', 'paying'] and order.status != 'cancelled' %}
            <p class="field-hint">
                {{ 'It can take a minute for the payment confirmation to arrive. Refresh this page, or check later with the link below.'|trans }}
            </p>
        {% endif %}

        {{ include('shop/_order-details.html.twig') }}

        <p>{{ 'Bookmark this page to check your order later: {link}track your order{/link}.'|trans({link: '<a href="' ~ track_url|e ~ '">', '/link': '</a>'})|raw }}</p>
    {% else %}
        <h1>{{ 'Order received'|trans }}</h1>
        <p>{{ 'If you just completed payment, it will be confirmed shortly and you\'ll get an email. You can check the status any time with your order number and email on the {link}order status page{/link}.'|trans({link: '<a href="' ~ path('order.track')|e ~ '">', '/link': '</a>'})|raw }}</p>
    {% endif %}

    <p><a href="{{ path('home') }}">{{ 'Continue shopping'|trans }}</a></p>
</section>
{% endblock %}
