{% extends 'layout/shop.html.twig' %}

{% set title = (search != '' ? (category ? 'Search: {query} in {category}'|trans({query: search, category: category.name}) : 'Search: {query}'|trans({query: search})) : (category ? category.name : (page > 1 ? 'All products'|trans : store.name))) ~ (page > 1 ? ' – ' ~ 'page {page}'|trans({page: page})) %}
{% set meta_description = category and category.description
    ? category.description|striptags|slice(0, 155)
    : (category ? 'Shop {category} at {store}.'|trans({category: category.name, store: store.name}) : 'Browse {count} product at {store}.'|trans_plural(total, {store: store.name})) %}
{# Search results and re-sorted lists aren't separate pages for search engines. #}
{% set robots = search != '' ? 'noindex, follow' : null %}
{% set canonical = absolute_url(path('home', {}, {category: active_category, page: page > 1 ? page : null})) %}
{% if category and category.image_path and image_size(category.image_path) %}
    {% set og_image = absolute_url(category.image_path) %}
{% elseif products is not empty and products[0].image_path %}
    {% set og_image = absolute_url(products[0].image_path) %}
{% endif %}

{% block content %}
{{ json_ld({
    '@graph': [
        {'@type': 'Organization', '@id': absolute_url('/') ~ '#organization', name: store.name, url: absolute_url('/'), email: store.email}
            |merge(store.logo_url ? {logo: absolute_url(store.logo_url|split('?')|first)} : {}),
        {'@type': 'WebSite', '@id': absolute_url('/') ~ '#website', name: store.name, url: absolute_url('/'),
         publisher: {'@id': absolute_url('/') ~ '#organization'},
         potentialAction: {'@type': 'SearchAction', target: {'@type': 'EntryPoint', urlTemplate: absolute_url('/') ~ '?q={search_term_string}'}, 'query-input': 'required name=search_term_string'}}
    ]
}) }}

{% if page == 1 and search == '' and category is null %}
    {{ theme_part('hero') }}
{% elseif category is null %}
    <h1 class="page-heading">{{ search != '' ? 'Search results'|trans : 'All products'|trans }}</h1>
{% endif %}

{% if category %}
    <section class="category-intro">
        {% set category_image = category.image_path ? image_size(category.image_path) : null %}
        {% if category_image %}
            <img src="/{{ category.image_path }}" alt="" class="category-intro-image"
                 width="{{ category_image.width }}" height="{{ category_image.height }}" decoding="async">
        {% endif %}
        <div class="category-intro-text">
            <h1>{{ category.name }}</h1>
            {% if category.description %}
                <p>{{ category.description|striptags|nl2br }}</p>
            {% endif %}
        </div>
    </section>
{% endif %}

<nav class="filters" aria-label="{{ 'Categories'|trans }}">
    <a href="{{ path('home', {}, {q: filters.q, sort: filters.sort}) }}" class="filter-pill {{ active_category is null ? 'active' }}"
       {% if active_category is null %}aria-current="page"{% endif %}>{{ 'All'|trans }}</a>
    {% for cat in categories %}
        <a href="{{ path('home', {}, {category: cat.slug, q: filters.q, sort: filters.sort}) }}"
           class="filter-pill {{ active_category == cat.slug ? 'active' }}"
           {% if active_category == cat.slug %}aria-current="page"{% endif %}>{{ cat.name }}</a>
    {% endfor %}
</nav>

<div class="shop-toolbar">
    <p class="results-summary">
    {% if search != '' %}
        {% if category %}{{ '{count} result for “{query}” in {category}.'|trans_plural(total, {query: search, category: category.name}) }}{% else %}{{ '{count} result for “{query}”.'|trans_plural(total, {query: search}) }}{% endif %}
        <a href="{{ path('home', {}, {category: active_category}) }}">{{ 'Clear search'|trans }}</a>
    {% elseif total > 0 %}
        {{ '{count} product'|trans_plural(total) }}{% if pages > 1 %} · {{ 'Page {page} of {pages}'|trans({page: page, pages: pages}) }}{% endif %}
    {% endif %}
    </p>
    {% if total > 1 %}
        {# Search itself lives in the header (theme part); this form keeps q and category. #}
        <form class="sort-form" action="{{ path('home') }}" method="get">
            {% if active_category %}<input type="hidden" name="category" value="{{ active_category }}">{% endif %}
            {% if search != '' %}<input type="hidden" name="q" value="{{ search }}">{% endif %}
            <label for="shop-sort">{{ 'Sort by'|trans }}</label>
            <select id="shop-sort" name="sort" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()">
                {% for key, label in sort_labels %}
                    <option value="{{ key }}" {{ key == sort ? 'selected' }}>{{ label|trans }}</option>
                {% endfor %}
            </select>
            <noscript><button type="submit" class="btn-secondary">{{ 'Sort'|trans }}</button></noscript>
        </form>
    {% endif %}
</div>

{% if products is not empty %}
    <section class="product-grid" aria-label="{{ 'Products'|trans }}">
        {% for product in products %}
            {% include 'shop/partials/product-card.html.twig' with {product: product, eager: loop.index <= 4 and page == 1} only %}
        {% endfor %}
    </section>
{% else %}
    <div class="empty-state">
        {% if search != '' %}
            <h2>{{ 'No products match “{query}”'|trans({query: search}) }}</h2>
            <p>{{ category ? 'Check the spelling, try fewer words, or search all categories.'|trans : 'Check the spelling, try fewer words.'|trans }}</p>
            <p>
                {% if category %}<a class="btn-secondary" href="{{ path('home', {}, {q: search}) }}">{{ 'Search all categories'|trans }}</a>{% endif %}
                <a class="btn-primary" href="{{ path('home') }}">{{ 'Browse all products'|trans }}</a>
            </p>
        {% elseif category %}
            <h2>{{ 'Nothing in {category} yet'|trans({category: category.name}) }}</h2>
            <p>{{ 'New products are on their way. Have a look at the rest of the shop in the meantime.'|trans }}</p>
            <p><a class="btn-primary" href="{{ path('home') }}">{{ 'Browse all products'|trans }}</a></p>
        {% else %}
            <h2>{{ 'The shop is being stocked'|trans }}</h2>
            <p>{{ 'There are no products yet — please check back soon.'|trans }}</p>
        {% endif %}
    </div>
{% endif %}

{% if pages > 1 %}
    <nav class="pagination" aria-label="{{ 'Pages'|trans }}">
        {% if page > 1 %}
            <a href="{{ path('home', {}, filters|merge({page: page - 1 > 1 ? page - 1 : null})) }}" rel="prev">‹ {{ 'Previous'|trans }}</a>
        {% endif %}
        {% for p in 1..pages %}
            {% if p == 1 or p == pages or (p >= page - 2 and p <= page + 2) %}
                {% if p == page %}
                    <span class="is-current" aria-current="page">{{ p }}</span>
                {% else %}
                    <a href="{{ path('home', {}, filters|merge({page: p > 1 ? p : null})) }}" aria-label="{{ 'Page {page}'|trans({page: p}) }}">{{ p }}</a>
                {% endif %}
            {% elseif p == page - 3 or p == page + 3 %}
                <span class="pagination-gap" aria-hidden="true">…</span>
            {% endif %}
        {% endfor %}
        {% if page < pages %}
            <a href="{{ path('home', {}, filters|merge({page: page + 1})) }}" rel="next">{{ 'Next'|trans }} ›</a>
        {% endif %}
    </nav>
{% endif %}
{% endblock %}
