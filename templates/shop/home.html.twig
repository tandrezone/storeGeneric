{% extends 'layout/shop.html.twig' %}

{% block content %}
{{ theme_part('hero') }}

<section class="filters">
    <a href="{{ path('home') }}" class="filter-pill {{ active_category is null ? 'active' }}">All</a>
    {% for category in categories %}
        <a href="{{ path('home', {}, {category: category.slug}) }}"
           class="filter-pill {{ active_category == category.slug ? 'active' }}">{{ category.name }}</a>
    {% endfor %}
</section>

<section class="product-grid">
    {% for product in products %}
        <a class="product-card" href="{{ path('product.show', {id: product.id}) }}">
            <div class="product-card-image">
                {% if product.image_path %}
                    <img src="/{{ product.image_path }}" alt="{{ product.name }}">
                {% else %}
                    <div class="image-placeholder">No image</div>
                {% endif %}
            </div>
            <div class="product-card-body">
                <span class="category-badge">{{ product.category_name }}</span>
                <h3>{{ product.name }}</h3>
                <p class="short-desc">{{ product.short_description }}</p>
                {% if product.from_price is not null %}
                    <p class="price">From {{ product.from_price|money }}</p>
                {% endif %}
            </div>
        </a>
    {% else %}
        <p>No products found in this category yet.</p>
    {% endfor %}
</section>
{% endblock %}
