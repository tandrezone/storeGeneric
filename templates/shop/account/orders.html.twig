{% extends 'layout/shop.html.twig' %}

{% set title = 'Your orders'|trans %}
{% set robots = 'noindex, nofollow' %}
{% set account_nav = 'orders' %}

{% block content %}
<section class="account-page">
    <h1>{{ 'Your orders'|trans }}</h1>
    {{ include('shop/account/_nav.html.twig') }}
    {{ include('shop/account/_flashes.html.twig') }}

    {% if orders is empty %}
        <p>{{ 'No orders yet.'|trans }} <a href="{{ path('home') }}">{{ 'Start shopping'|trans }}</a>.</p>
        {% if not customer.email_verified_at %}
            <p class="field-hint">{{ 'Orders you placed as a guest appear here once you confirm your email address.'|trans }}</p>
        {% endif %}
    {% else %}
        <p class="field-hint">{{ '{count} order'|trans_plural(total) }}</p>
        {{ include('shop/account/_order-list.html.twig') }}

        {% if total_pages > 1 %}
            <nav class="pagination" aria-label="{{ 'Pages'|trans }}">
                {% if page > 1 %}<a href="{{ path('account.orders', {}, {page: page - 1}) }}" class="btn-secondary" rel="prev">‹ {{ 'Newer'|trans }}</a>{% endif %}
                <span>{{ 'Page {page} of {pages}'|trans({page: page, pages: total_pages}) }}</span>
                {% if page < total_pages %}<a href="{{ path('account.orders', {}, {page: page + 1}) }}" class="btn-secondary" rel="next">{{ 'Older'|trans }} ›</a>{% endif %}
            </nav>
        {% endif %}
    {% endif %}
</section>
{% endblock %}
