{% extends 'layout/shop.html.twig' %}

{% set title = 'Confirm your email'|trans %}
{% set robots = 'noindex, nofollow' %}
{% set canonical = null %}

{% block content %}
<section class="account-page account-auth-page">
    <h1>{{ 'Confirm your email'|trans }}</h1>
    <p>{{ 'This confirmation link is invalid, has already been used or has expired, or it was for an email address the account no longer uses.'|trans }}</p>
    {% if customer %}
        {% if customer.email_verified_at %}
            <p>{{ 'Your email address {email} is confirmed.'|trans({email: customer.email}) }} <a href="{{ path('account') }}">{{ 'Go to your account'|trans }}</a>.</p>
        {% else %}
            <form method="post" action="{{ path('account.verify.resend') }}">
                {{ csrf_field() }}
                <button type="submit" class="btn-primary">{{ 'Send a new link to {email}'|trans({email: customer.email}) }}</button>
            </form>
        {% endif %}
    {% else %}
        <p>{{ '{link}Sign in{/link} to get a new link.'|trans({link: '<a href="' ~ path('account.login', {}, {next: path('account')})|e ~ '">', '/link': '</a>'})|raw }}</p>
    {% endif %}
</section>
{% endblock %}
