{% extends 'layout/shop.html.twig' %}

{% set title = 'Choose a new password'|trans %}
{% set robots = 'noindex, nofollow' %}
{% set canonical = null %}

{% block content %}
<section class="account-page account-auth-page">
    <h1>{{ 'Choose a new password'|trans }}</h1>
    {{ include('shop/account/_flashes.html.twig') }}

    {% if valid %}
        {# data-no-ajax: a successful reset signs you in (new header and form token). #}
        <form method="post" action="{{ path('account.reset.submit') }}" class="shipping-form account-form" data-no-ajax>
            {{ csrf_field() }}
            <input type="hidden" name="token" value="{{ token }}">

            <label for="reset-password">{{ 'New password'|trans }}</label>
            <input type="password" id="reset-password" name="password" required minlength="{{ min_password }}" autocomplete="new-password" aria-describedby="reset-password-hint">
            <p class="field-hint" id="reset-password-hint">{{ 'At least {min} characters.'|trans({min: min_password}) }}</p>

            <label for="reset-password-confirm">{{ 'Repeat new password'|trans }}</label>
            <input type="password" id="reset-password-confirm" name="password_confirm" required minlength="{{ min_password }}" autocomplete="new-password">

            <button type="submit" class="btn-primary">{{ 'Save password'|trans }}</button>
        </form>
    {% else %}
        <p>{{ 'This reset link is invalid, has already been used or has expired (links work for one hour).'|trans }}</p>
        <p><a href="{{ path('account.forgot') }}" class="btn-primary">{{ 'Request a new link'|trans }}</a></p>
    {% endif %}
</section>
{% endblock %}
