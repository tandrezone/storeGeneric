{% extends 'layout/shop.html.twig' %}

{% set title = 'Forgot your password?' %}
{% set robots = 'noindex, nofollow' %}

{% block content %}
<section class="account-page account-auth-page">
    <h1>Forgot your password?</h1>
    {{ include('shop/account/_flashes.html.twig') }}

    {% if sent %}
        <p class="msg" role="status">If an account exists for {{ email }}, we've sent it a link to choose a new password.
           The link works once and expires in {{ minutes }} minutes.</p>
        <p>Nothing arrived? Check your spam folder, or <a href="{{ path('account.forgot', {}, {email: email}) }}">try again</a>.</p>
    {% else %}
        <p>Enter the email address of your account and we'll send you a link to choose a new password.</p>
        <form method="post" action="{{ path('account.forgot.submit') }}" class="shipping-form account-form">
            {{ csrf_field() }}
            <label for="forgot-email">Email</label>
            <input type="email" id="forgot-email" name="email" required maxlength="190" value="{{ email }}" autocomplete="email">
            <button type="submit" class="btn-primary">Send reset link</button>
        </form>
    {% endif %}

    <p><a href="{{ path('account.login') }}">Back to sign in</a></p>
</section>
{% endblock %}
