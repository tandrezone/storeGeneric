{% extends 'layout/shop.html.twig' %}

{% set title = 'Forgot your password?'|trans %}
{% set robots = 'noindex, nofollow' %}

{% block content %}
<section class="account-page account-auth-page">
    <h1>{{ 'Forgot your password?'|trans }}</h1>
    {{ include('shop/account/_flashes.html.twig') }}

    {% if sent %}
        <p class="msg" role="status">{{ 'If an account exists for {email}, we\'ve sent it a link to choose a new password. The link works once and expires in {minutes} minutes.'|trans({email: email, minutes: minutes}) }}</p>
        <p>{{ 'Nothing arrived? Check your spam folder, or {link}try again{/link}.'|trans({link: '<a href="' ~ path('account.forgot', {}, {email: email})|e ~ '">', '/link': '</a>'})|raw }}</p>
    {% else %}
        <p>{{ 'Enter the email address of your account and we\'ll send you a link to choose a new password.'|trans }}</p>
        <form method="post" action="{{ path('account.forgot.submit') }}" class="shipping-form account-form">
            {{ csrf_field() }}
            <label for="forgot-email">{{ 'Email'|trans }}</label>
            <input type="email" id="forgot-email" name="email" required maxlength="190" value="{{ email }}" autocomplete="email">
            <button type="submit" class="btn-primary">{{ 'Send reset link'|trans }}</button>
        </form>
    {% endif %}

    <p><a href="{{ path('account.login') }}">{{ 'Back to sign in'|trans }}</a></p>
</section>
{% endblock %}
