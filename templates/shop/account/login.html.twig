{% extends 'layout/shop.html.twig' %}

{% set title = 'Sign in' %}
{% set robots = 'noindex, nofollow' %}

{% block content %}
<section class="account-page account-auth-page">
    <h1>Sign in</h1>
    {{ include('shop/account/_flashes.html.twig') }}

    {# data-no-ajax: signing in changes the header and the form token, so reload the whole page. #}
    <form method="post" action="{{ path('account.login.submit') }}" class="shipping-form account-form" data-no-ajax>
        {{ csrf_field() }}
        {% if next %}<input type="hidden" name="next" value="{{ next }}">{% endif %}

        <label for="login-email">Email</label>
        <input type="email" id="login-email" name="email" required value="{{ email }}" autocomplete="email" maxlength="190">

        <label for="login-password">Password</label>
        <input type="password" id="login-password" name="password" required autocomplete="current-password">

        <button type="submit" class="btn-primary">Sign in</button>
    </form>

    <p><a href="{{ path('account.forgot', {}, {email: email ?: null}) }}">Forgot your password?</a></p>
    <p>New here? <a href="{{ path('account.register', {}, {next: next ?: null}) }}">Create an account</a> — or simply
       <a href="{{ path('cart') }}">check out as a guest</a>, no account needed.</p>
</section>
{% endblock %}
