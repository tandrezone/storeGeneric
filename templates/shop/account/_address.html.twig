{# A saved address (`address`, customer_addresses row) as text. #}
<address class="account-address">
    {% if address.label %}<strong>{{ address.label }}</strong>{% if address.is_default %} <span class="status-badge" data-status="paid">{{ 'default'|trans }}</span>{% endif %}<br>{% elseif address.is_default %}<span class="status-badge" data-status="paid">{{ 'default'|trans }}</span><br>{% endif %}
    {{ address.name }}<br>
    {{ address.address1 }}<br>
    {% if address.address2 %}{{ address.address2 }}<br>{% endif %}
    {{ address.postal_code }} {{ address.city }}{% if address.state %}, {{ address.state }}{% endif %}<br>
    {{ address.country }}
    {% if address.phone %}<br>{{ address.phone }}{% endif %}
</address>
