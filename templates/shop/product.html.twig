{% extends 'layout/shop.html.twig' %}

{% set title = product.name %}

{% block content %}
<section class="product-detail">
    <div class="product-detail-image">
        <div class="product-gallery" data-gallery>
            <div class="product-gallery-main">
                {% for image in images %}
                    <img src="/{{ image }}" alt="{{ product.name }}"
                         class="gallery-slide{{ loop.first ? ' is-active' }}" data-index="{{ loop.index0 }}">
                {% endfor %}
                {% if images|length > 1 %}
                    <button type="button" class="gallery-nav gallery-prev" aria-label="Previous image">&#8249;</button>
                    <button type="button" class="gallery-nav gallery-next" aria-label="Next image">&#8250;</button>
                {% endif %}
            </div>
            {% if images|length > 1 %}
                <div class="product-gallery-thumbs">
                    {% for image in images %}
                        <button type="button" class="gallery-thumb{{ loop.first ? ' is-active' }}" data-index="{{ loop.index0 }}">
                            <img src="/{{ image }}" alt="">
                        </button>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="product-detail-info">
        <span class="category-badge">{{ product.category_name }}</span>
        <h1>{{ product.name }}</h1>
        <p class="short-desc">{{ product.short_description }}</p>

        <form id="add-to-cart-form" data-no-ajax data-product-id="{{ product.id }}">
            <label for="variant-select">Choose an option</label>
            <select id="variant-select" name="variant_id" required>
                {% for variant in variants %}
                    <option value="{{ variant.id }}" data-price="{{ variant.price }}" {{ variant.stock <= 0 ? 'disabled' }}>
                        {{ (variant.label ~ ' ' ~ variant.unit)|trim }} — {{ variant.price|money }}
                        {{ variant.stock <= 0 ? '(out of stock)' }}
                    </option>
                {% endfor %}
            </select>

            <label for="quantity-input">Quantity</label>
            <input type="number" id="quantity-input" name="quantity" value="1" min="1" required>

            <button type="submit" class="btn-primary">Add to cart</button>
            <p id="add-to-cart-message" class="form-message" role="status"></p>
        </form>

        <div class="long-description">
            <h2>Description</h2>
            {{ description_html|raw }}{# sanitized by HtmlSanitizer in the controller #}
        </div>
    </div>
</section>
{% endblock %}
