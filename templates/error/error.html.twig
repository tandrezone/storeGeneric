{% extends 'layout/shop.html.twig' %}

{% set title = status == 404 ? 'Page not found' : 'Error' %}

{% block content %}
<section class="content-page">
    <h1>{{ status == 404 ? 'Page not found' : (status == 400 ? 'Request not accepted' : 'Something went wrong') }}</h1>
    <p class="page-subtitle">{{ message }}</p>
    <p><a href="{{ path('home') }}" class="btn-primary">Back to the shop</a></p>
    {% if detail %}
        <pre class="magic-output" style="display:block;">{{ detail }}</pre>
    {% endif %}
</section>
{% endblock %}
