{% extends 'layout/admin.html.twig' %}

{% set title = 'Admin — Categories'|trans %}
{% set active_nav = 'categories' %}

{% block content %}
<h1>{{ 'Categories'|trans }}</h1>

{% for error in errors|default([]) %}<p class="msg error">{{ error }}</p>{% endfor %}

{% set new_input = input is not null and input.id|default(0) == 0 ? input : null %}
<div class="panel">
    <h2>{{ 'Add category'|trans }}</h2>
    <form method="post" action="{{ path('admin.categories.submit') }}" enctype="multipart/form-data" class="category-edit-form">
        {{ csrf_field() }}
        <input type="hidden" name="action" value="create">
        <label>{{ 'Name'|trans }} <input type="text" name="name" value="{{ new_input.name|default('') }}" maxlength="{{ limits.name }}" required></label>
        <label>{{ 'Description (optional)'|trans }}
            <textarea name="description" maxlength="{{ limits.description }}" rows="3">{{ new_input.description|default('') }}</textarea>
        </label>
        <label>{{ 'Image (optional)'|trans }}
            <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif">
        </label>
        <p class="field-hint">{{ 'Shown at the top of the category on the storefront. PNG, JPG, WebP or GIF, up to 8 MB.'|trans }}</p>
        <div><button type="submit" class="btn-primary">{{ 'Add category'|trans }}</button></div>
    </form>
</div>

<h2>{{ 'Existing categories'|trans }}</h2>
<table class="cart-table admin-table">
    <thead><tr><th></th><th>{{ 'Name'|trans }}</th><th>{{ 'Slug'|trans }}</th><th>{{ 'Products'|trans }}</th><th>{{ 'Actions'|trans }}</th></tr></thead>
    <tbody>
        {% for category in categories %}
            {% set ci = input is not null and input.id|default(0) == category.id ? input : null %}
            <tr>
                <td>
                    {% if category.image_path %}
                        <img src="/{{ category.image_path }}" alt="" class="category-thumb">
                    {% else %}
                        <div class="product-thumb product-thumb-empty">—</div>
                    {% endif %}
                </td>
                <td>
                    {{ category.name }}
                    {% if category.description %}<br><span class="field-hint">{{ category.description|length > 90 ? category.description|slice(0, 90) ~ '…' : category.description }}</span>{% endif %}
                </td>
                <td><span class="field-hint">{{ category.slug }}</span></td>
                <td>{{ category.product_count }}</td>
                <td>
                    <div class="table-actions">
                        <button type="button" class="btn-secondary btn-small" data-toggle="category-edit-{{ category.id }}" aria-expanded="{{ ci ? 'true' : 'false' }}">{{ 'Edit'|trans }}</button>
                        {% if admin_can('manager') %}
                            <form method="post" action="{{ path('admin.categories.submit') }}" class="inline-form"
                                  data-confirm="{{ 'Delete "{name}"? This cannot be undone.'|trans({name: category.name}) }}">
                                {{ csrf_field() }}
                                <input type="hidden" name="action" value="delete">
                                <input type="hidden" name="id" value="{{ category.id }}">
                                <button type="submit" class="icon-btn icon-btn-danger" title="{{ 'Delete category'|trans }}">🗑</button>
                            </form>
                        {% endif %}
                    </div>
                </td>
            </tr>
            <tr class="edit-row" id="category-edit-{{ category.id }}" {{ ci ? '' : 'hidden' }}>
                <td colspan="5">
                    <form method="post" action="{{ path('admin.categories.submit') }}" enctype="multipart/form-data" class="category-edit-form">
                        {{ csrf_field() }}
                        <input type="hidden" name="action" value="update">
                        <input type="hidden" name="id" value="{{ category.id }}">
                        <label>{{ 'Name'|trans }}
                            <input type="text" name="name" value="{{ ci ? ci.name|default('') : category.name }}" maxlength="{{ limits.name }}" required>
                        </label>
                        <label>{{ 'Description'|trans }}
                            <textarea name="description" maxlength="{{ limits.description }}" rows="3">{{ ci ? ci.description|default('') : category.description }}</textarea>
                        </label>
                        <div class="category-image-row">
                            {% if category.image_path %}
                                <img src="/{{ category.image_path }}" alt="{{ 'Current image'|trans }}">
                                <label class="inline-check"><input type="checkbox" name="remove_image" value="1"> {{ 'Remove image'|trans }}</label>
                            {% endif %}
                            <label>{{ category.image_path ? 'Replace image'|trans : 'Image'|trans }}
                                <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif">
                            </label>
                        </div>
                        <div><button type="submit" class="btn-primary">{{ 'Save category'|trans }}</button></div>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5" style="color: var(--color-muted);">{{ 'No categories yet.'|trans }}</td></tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
