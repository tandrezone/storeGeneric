{% extends 'layout/admin.html.twig' %}

{% set title = 'Admin — {page}'|trans({page: 'Dashboard'|trans}) %}
{% set active_nav = 'dashboard' %}

{% block content %}
<h1>{{ 'Dashboard'|trans }}</h1>

<div class="stat-grid">
    {% for kpi in kpis %}
        {% if show_revenue %}
            <div class="stat-tile">
                <span class="stat-label">{{ 'Revenue · {period}'|trans({period: kpi.label}) }}</span>
                <span class="stat-value">{{ kpi.revenue|money }}</span>
                <span class="stat-sub">{{ '{count} paid · avg {amount}'|trans_plural(kpi.paid_orders, {amount: kpi.average|money}) }}</span>
            </div>
        {% endif %}
        <div class="stat-tile">
            <span class="stat-label">{{ 'Orders · {period}'|trans({period: kpi.label}) }}</span>
            <span class="stat-value">{{ kpi.orders|number_format }}</span>
            <span class="stat-sub">{{ '{count} paid'|trans_plural(kpi.paid_orders) }}</span>
        </div>
    {% endfor %}
    <a class="stat-tile" href="{{ path('admin.orders', {}, {status: 'paid'}) }}">
        <span class="stat-label">{{ 'To ship'|trans }}</span>
        <span class="stat-value">{{ awaiting.to_ship|number_format }}</span>
        <span class="stat-sub">{{ 'paid, not shipped'|trans }}</span>
    </a>
    <a class="stat-tile" href="{{ path('admin.orders', {}, {status: 'pending'}) }}">
        <span class="stat-label">{{ 'Awaiting payment'|trans }}</span>
        <span class="stat-value">{{ awaiting.awaiting_payment|number_format }}</span>
        <span class="stat-sub">{{ 'bank transfer / cash on delivery'|trans }}</span>
    </a>
    <a class="stat-tile" href="{{ path('admin.products', {}, {stock: 'low'}) }}">
        <span class="stat-label">{{ 'Low stock'|trans }}</span>
        <span class="stat-value">{{ low_stock_count|number_format }}</span>
        <span class="stat-sub">{{ 'variants at {threshold} or less'|trans({threshold: threshold}) }}</span>
    </a>
</div>

{% if show_revenue %}
<div class="panel">
    <h2>{{ 'Revenue, last {days} days'|trans({days: chart_days}) }}</h2>
    <div class="chart-legend">
        <span class="legend-item"><span class="legend-swatch legend-swatch-line legend-teal"></span>{{ 'Revenue from paid orders'|trans }}</span>
    </div>
    <div class="chart-wrap" id="revenue-chart" data-points="{{ daily|json_encode }}"></div>
    <details class="chart-table-toggle">
        <summary>{{ 'View as table'|trans }}</summary>
        <table class="cart-table admin-table">
            <thead><tr><th>{{ 'Day'|trans }}</th><th class="tabular">{{ 'Revenue'|trans }}</th><th class="tabular">{{ 'Paid orders'|trans }}</th></tr></thead>
            <tbody>
                {% for point in daily %}
                    <tr>
                        <td>{{ point.day }}</td>
                        <td class="tabular">{{ point.revenue|money }}</td>
                        <td class="tabular">{{ point.orders|number_format }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </details>
</div>
{% endif %}

<div class="analytics-grid-2col">
    <div class="panel">
        <h2>{{ 'Orders awaiting action'|trans }}</h2>
        <table class="cart-table admin-table">
            <thead><tr><th>{{ 'Order #'|trans }}</th><th>{{ 'Waiting for'|trans }}</th><th>{{ 'Method'|trans }}</th><th class="tabular">{{ 'Total'|trans }}</th><th>{{ 'Placed'|trans }}</th></tr></thead>
            <tbody>
                {% for order in awaiting_orders %}
                    <tr>
                        <td><a href="{{ path('admin.order', {id: order.id}) }}">{{ order.order_number }}</a><br><span class="field-hint">{{ order.ship_name }}</span></td>
                        <td><span class="status-badge" data-status="{{ order.waiting_for == 'ship' ? 'paid' : 'pending' }}">{{ order.waiting_for == 'ship' ? 'Shipping'|trans : 'Payment'|trans }}</span></td>
                        <td class="field-hint">{{ payment_labels[order.payment_method] ?? order.payment_method }}</td>
                        <td class="tabular">{{ order.total|money }}</td>
                        <td class="field-hint">{{ order.created_at }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" style="color: var(--color-muted);">{{ 'Nothing waiting — all caught up.'|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="panel">
        <h2>{{ 'Low stock'|trans }}</h2>
        <table class="cart-table admin-table">
            <thead><tr><th>{{ 'Product'|trans }}</th><th>{{ 'Variant'|trans }}</th><th class="tabular">{{ 'Stock'|trans }}</th></tr></thead>
            <tbody>
                {% for v in low_stock %}
                    <tr>
                        <td><a href="{{ path('admin.products', {}, {edit: v.product_id}) }}">{{ v.product_name }}</a></td>
                        <td class="field-hint">{{ v.label ?: v.sku }}{{ v.unit ? ' · ' ~ v.unit }}</td>
                        <td class="tabular"><span class="stock-badge {{ v.stock <= 0 ? 'is-out' : 'is-low' }}">{{ v.stock }}</span></td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" style="color: var(--color-muted);">{{ 'No variant is at or below {threshold}.'|trans({threshold: threshold}) }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
        {% if low_stock_count > low_stock|length %}
            <p class="field-hint"><a href="{{ path('admin.products', {}, {stock: 'low'}) }}">{{ 'All {count} low-stock variants →'|trans({count: low_stock_count}) }}</a></p>
        {% endif %}
    </div>

    <div class="panel">
        <h2>{{ 'Top sellers, last 30 days'|trans }}</h2>
        <table class="cart-table admin-table">
            <thead><tr><th>{{ 'Product'|trans }}</th><th class="tabular">{{ 'Units'|trans }}</th>{% if show_revenue %}<th class="tabular">{{ 'Revenue'|trans }}</th>{% endif %}</tr></thead>
            <tbody>
                {% for p in top_products %}
                    <tr>
                        <td><a href="{{ path('admin.products', {}, {edit: p.product_id}) }}">{{ p.name }}</a></td>
                        <td class="tabular">{{ p.units|number_format }}</td>
                        {% if show_revenue %}<td class="tabular">{{ p.revenue|money }}</td>{% endif %}
                    </tr>
                {% else %}
                    <tr><td colspan="{{ show_revenue ? 3 : 2 }}" style="color: var(--color-muted);">{{ 'No paid orders in the last 30 days.'|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="panel">
        <h2>{{ 'Recent orders'|trans }}</h2>
        <table class="cart-table admin-table">
            <thead><tr><th>{{ 'Order #'|trans }}</th><th>{{ 'Status'|trans }}</th><th>{{ 'Payment'|trans }}</th><th class="tabular">{{ 'Total'|trans }}</th></tr></thead>
            <tbody>
                {% for order in recent_orders %}
                    <tr>
                        <td><a href="{{ path('admin.order', {id: order.id}) }}">{{ order.order_number }}</a><br><span class="field-hint">{{ order.created_at }}</span></td>
                        <td><span class="status-badge" data-status="{{ order.status }}">{{ order.status|capitalize|trans }}</span></td>
                        <td><span class="status-badge" data-status="{{ order.payment_status }}">{{ order.payment_status|capitalize|trans }}</span></td>
                        <td class="tabular">{{ order.total|money }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" style="color: var(--color-muted);">{{ 'No orders yet.'|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
        <p class="field-hint"><a href="{{ path('admin.orders') }}">{{ 'All orders →'|trans }}</a></p>
    </div>
</div>

{% if show_revenue %}<script src="/assets/js/dashboard.js"></script>{% endif %}
{% endblock %}
