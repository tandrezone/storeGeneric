{% extends 'layout/admin.html.twig' %}

{% set title = 'Admin — Settings' %}
{% set active_nav = 'settings' %}

{% block content %}
<h1>Settings</h1>

{% for error in errors %}<p class="msg error">{{ error }}</p>{% endfor %}

<section class="panel">
    <h2>Store</h2>
    <form method="post" action="{{ path('admin.settings.submit') }}" enctype="multipart/form-data" data-no-ajax>
        {{ csrf_field() }}
        <input type="hidden" name="action" value="save_store">
        <div class="form-row">
            <label>Store name
                <input type="text" name="store_name" value="{{ store.name }}" maxlength="80" required>
            </label>
            <label>Support email (optional)
                <input type="email" name="store_email" value="{{ saved_email }}" placeholder="{{ store.email }}">
            </label>
        </div>

        <label>Logo</label>
        <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
            {% if store.logo_url %}
                <img src="{{ store.logo_url }}" alt="Current logo"
                     style="height: 56px; width: auto; max-width: 220px; object-fit: contain; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 6px; background: var(--color-surface);">
            {% else %}
                <span class="field-hint">No logo — the store name is shown as text.</span>
            {% endif %}
            <input type="file" name="logo" accept="image/png,image/jpeg,image/webp,image/gif" style="max-width: 320px;">
        </div>
        <p class="field-hint">PNG, JPG, WebP or GIF, up to 2 MB. A wide logo about 72 px tall looks best; it's shown 36 px high.</p>
        <label style="display: flex; align-items: center; gap: 8px;">
            <input type="checkbox" name="logo_show_name" value="1" style="width: auto;" {{ show_name_with_logo ? 'checked' }}>
            Show the store name next to the logo
        </label>

        <button type="submit" class="btn-primary">Save store settings</button>
    </form>
    {% if store.logo_url %}
        <form method="post" action="{{ path('admin.settings.submit') }}" data-no-ajax style="margin-top: 10px;" data-confirm="Remove the logo?">
            {{ csrf_field() }}
            <input type="hidden" name="action" value="remove_logo">
            <button type="submit" class="btn-danger">Remove logo</button>
        </form>
    {% endif %}
</section>

<section class="panel">
    <h2>Themes</h2>
    <p class="field-hint" style="margin-bottom: 18px;">The theme changes how the shop (and this admin panel) looks. Your products and orders aren't affected.</p>

    <div class="product-grid">
        {% for t in themes %}
            {% set active = t.slug == active_theme %}
            <div class="product-card" {% if active %}style="outline: 3px solid var(--color-accent); outline-offset: 2px;"{% endif %}>
                <div class="product-card-image">
                    {% if t.screenshot %}
                        <img src="{{ t.screenshot }}" alt="{{ t.name }} preview" loading="lazy">
                    {% else %}
                        <div class="image-placeholder">No preview</div>
                    {% endif %}
                </div>
                <div class="product-card-body">
                    <span class="category-badge">{{ t.builtin ? 'Built-in' : 'Uploaded' }}</span>
                    <h3>{{ t.name }}</h3>
                    {% if t.description %}<p class="short-desc">{{ t.description }}</p>{% endif %}
                    {% if not t.builtin and (t.author or t.version) %}
                        <p class="field-hint">{{ t.author }}{{ t.author and t.version ? ' · ' }}{{ t.version ? 'v' ~ t.version }}</p>
                    {% endif %}

                    <div class="table-actions" style="margin-top: 12px;">
                        {% if active %}
                            <span class="status-badge" data-status="approved">Active</span>
                        {% else %}
                            <form method="post" action="{{ path('admin.settings.submit') }}" class="inline-form" data-no-ajax>
                                {{ csrf_field() }}
                                <input type="hidden" name="action" value="activate_theme">
                                <input type="hidden" name="theme" value="{{ t.slug }}">
                                <button type="submit" class="btn-secondary">Use this theme</button>
                            </form>
                            {% if not t.builtin %}
                                <form method="post" action="{{ path('admin.settings.submit') }}" class="inline-form" data-no-ajax
                                      data-confirm="Delete the &quot;{{ t.name }}&quot; theme?">
                                    {{ csrf_field() }}
                                    <input type="hidden" name="action" value="delete_theme">
                                    <input type="hidden" name="theme" value="{{ t.slug }}">
                                    <button type="submit" class="icon-btn icon-btn-danger" title="Delete theme">🗑</button>
                                </form>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</section>

<section class="panel">
    <h2>Upload your own theme</h2>
    <p>
        Start from the blank theme: it contains the folder structure, a commented stylesheet,
        the default Twig templates and a README explaining every file.
    </p>
    <p><a href="{{ path('admin.settings.blank_theme') }}" class="btn-secondary" data-no-ajax>⬇ Download blank theme (.zip)</a></p>

    <form method="post" action="{{ path('admin.settings.submit') }}" enctype="multipart/form-data" data-no-ajax>
        {{ csrf_field() }}
        <input type="hidden" name="action" value="upload_theme">
        <label>Theme .zip file
            <input type="file" name="theme_zip" accept=".zip,application/zip" required>
        </label>
        <label style="display: flex; align-items: center; gap: 8px;">
            <input type="checkbox" name="activate" value="1" style="width: auto;" checked> Use it right away
        </label>
        <label style="display: flex; align-items: center; gap: 8px;">
            <input type="checkbox" name="replace" value="1" style="width: auto;"> Replace a theme with the same name
        </label>
        <p class="field-hint">
            Max 20 MB. Allowed: Twig templates in layout/, CSS, images, fonts and theme.json — never PHP.
            Templates run in a sandbox and are checked on upload.
        </p>
        <button type="submit" class="btn-primary">Upload theme</button>
    </form>
</section>
{% endblock %}
