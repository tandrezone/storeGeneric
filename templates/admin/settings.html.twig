{% extends 'layout/admin.html.twig' %}

{% set title = 'Admin — {page}'|trans({page: 'Settings'|trans}) %}
{% set active_nav = 'settings' %}

{% block content %}
<h1>{{ 'Settings'|trans }}</h1>

{% for error in errors %}<p class="msg error">{{ error }}</p>{% endfor %}

<section class="panel">
    <h2>{{ 'Store'|trans }}</h2>
    <form method="post" action="{{ path('admin.settings.submit') }}" enctype="multipart/form-data" data-no-ajax>
        {{ csrf_field() }}
        <input type="hidden" name="action" value="save_store">
        <div class="form-row">
            <label>{{ 'Store name'|trans }}
                <input type="text" name="store_name" value="{{ store.name }}" maxlength="80" required>
            </label>
            <label>{{ 'Support email (optional)'|trans }}
                <input type="email" name="store_email" value="{{ saved_email }}" placeholder="{{ store.email }}">
            </label>
        </div>

        <label>{{ 'Store language'|trans }}
            <select name="store_language">
                {% for language in languages() %}
                    <option value="{{ language.code }}" {{ language.code == store_language ? 'selected' }}>{{ language.name }}</option>
                {% endfor %}
            </select>
        </label>
        <p class="field-hint">{{ 'The default language of the shop, and of emails for orders placed without one. Visitors can still switch between English and Portuguese.'|trans }}</p>

        <label>{{ 'Logo'|trans }}</label>
        <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
            {% if store.logo_url %}
                <img src="{{ store.logo_url }}" alt="{{ 'Current logo'|trans }}"
                     style="height: 56px; width: auto; max-width: 220px; object-fit: contain; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 6px; background: var(--color-surface);">
            {% else %}
                <span class="field-hint">{{ 'No logo — the store name is shown as text.'|trans }}</span>
            {% endif %}
            <input type="file" name="logo" accept="image/png,image/jpeg,image/webp,image/gif" style="max-width: 320px;">
        </div>
        <p class="field-hint">{{ 'PNG, JPG, WebP or GIF, up to 2 MB. A wide logo about 72 px tall looks best; it\'s shown 36 px high.'|trans }}</p>
        <label style="display: flex; align-items: center; gap: 8px;">
            <input type="checkbox" name="logo_show_name" value="1" style="width: auto;" {{ show_name_with_logo ? 'checked' }}>
            {{ 'Show the store name next to the logo'|trans }}
        </label>

        <button type="submit" class="btn-primary">{{ 'Save store settings'|trans }}</button>
    </form>
    {% if store.logo_url %}
        <form method="post" action="{{ path('admin.settings.submit') }}" data-no-ajax style="margin-top: 10px;" data-confirm="{{ 'Remove the logo?'|trans }}">
            {{ csrf_field() }}
            <input type="hidden" name="action" value="remove_logo">
            <button type="submit" class="btn-danger">{{ 'Remove logo'|trans }}</button>
        </form>
    {% endif %}
</section>

<section class="panel">
    <h2>{{ 'Inventory'|trans }}</h2>
    <form method="post" action="{{ path('admin.settings.submit') }}">
        {{ csrf_field() }}
        <input type="hidden" name="action" value="save_inventory">
        <label>{{ 'Low-stock threshold'|trans }}
            <input type="number" name="low_stock_threshold" value="{{ low_stock_threshold }}" min="0" max="1000000" step="1" required>
        </label>
        <p class="field-hint">
            {{ 'Active variants with this many items or fewer are flagged as low stock in Admin → Products (use 0 to flag only sold-out variants).'|trans }}
        </p>
        <button type="submit" class="btn-primary">{{ 'Save inventory settings'|trans }}</button>
    </form>
</section>

<section class="panel">
    <h2>{{ 'Marketplace orders'|trans }}</h2>
    <p class="field-hint">{{ 'Let a connector for a marketplace or delivery app (Glovo, Bolt Food, Uber Eats, Wolt, Just Eat…) post its orders to this store. They appear in Orders as paid, with the marketplace as source, and take stock. Nothing is emailed to the customer.'|trans }}</p>
    {% if marketplace.new_key %}
        <p class="msg success">{{ 'Your new API key (copy it now, it is not shown again):'|trans }}<br><code style="user-select: all; word-break: break-all;">{{ marketplace.new_key }}</code></p>
    {% endif %}
    <p>{{ 'Endpoint'|trans }}: <code>POST {{ marketplace.endpoint }}</code> — <code>Authorization: Bearer &lt;key&gt;</code></p>
    <form method="post" action="{{ path('admin.settings.submit') }}" class="inline-form" {% if marketplace.has_key %}data-confirm="{{ 'Create a new key? The old one stops working immediately.'|trans }}"{% endif %}>
        {{ csrf_field() }}
        <input type="hidden" name="action" value="marketplace_key">
        <button type="submit" class="btn-primary">{{ marketplace.has_key ? 'Replace the API key'|trans : 'Create an API key'|trans }}</button>
    </form>
    {% if marketplace.has_key %}
        <form method="post" action="{{ path('admin.settings.submit') }}" class="inline-form" data-confirm="{{ 'Revoke the key? Imports stop until you create a new one.'|trans }}">
            {{ csrf_field() }}
            <input type="hidden" name="action" value="marketplace_key">
            <input type="hidden" name="do" value="revoke">
            <button type="submit" class="btn-secondary">{{ 'Revoke the key'|trans }}</button>
        </form>
    {% endif %}
</section>

<section class="panel">
    <h2>{{ 'Currencies'|trans }}</h2>
    <form method="post" action="{{ path('admin.settings.submit') }}">
        {{ csrf_field() }}
        <input type="hidden" name="action" value="save_currencies">
        <label>{{ 'Show approximate prices in (1 {base} = …)'|trans({base: currencies.base}) }}
            <input type="text" name="currency_rates" value="{{ currencies.rates }}" maxlength="500" placeholder="USD=1.10, GBP=0.85">
        </label>
        <label style="display: flex; align-items: center; gap: 8px;">
            <input type="checkbox" name="currency_rates_auto" value="1" style="width: auto;" {{ currencies.auto ? 'checked' }}>
            {{ 'Refresh these rates daily from the European Central Bank (cron: currency:update)'|trans }}
        </label>
        <p class="field-hint">
            {{ 'Visitors can pick one of these currencies to see "≈" prices next to the catalogue prices. It is display only: the cart, checkout and every order are in {base}, and customers always pay in {base}.'|trans({base: currencies.base}) }}
            {% if currencies.date %}{{ 'ECB rates of {date}.'|trans({date: currencies.date}) }}{% endif %}
        </p>
        <button type="submit" class="btn-primary">{{ 'Save currency settings'|trans }}</button>
        {% if currencies.base == 'EUR' %}<button type="submit" name="do" value="update_now" class="btn-secondary">{{ 'Save and update the rates now'|trans }}</button>{% endif %}
    </form>
</section>

<section class="panel">
    <h2>{{ 'Abandoned carts'|trans }}</h2>
    <form method="post" action="{{ path('admin.settings.submit') }}">
        {{ csrf_field() }}
        <input type="hidden" name="action" value="save_carts">
        <label style="display: flex; align-items: center; gap: 8px;">
            <input type="checkbox" name="abandoned_cart_enabled" value="1" style="width: auto;" {{ cart_reminders.enabled ? 'checked' }}>
            {{ 'Email a reminder to signed-in customers who leave items in their cart'|trans }}
        </label>
        <label>{{ 'Send it after this many hours without activity'|trans }}
            <input type="number" name="abandoned_cart_hours" value="{{ cart_reminders.hours }}" min="1" max="168" step="1" required>
        </label>
        <p class="field-hint">{{ 'One reminder per cart, only to customers with a verified account who haven\'t ordered since. Needs the cron jobs "bin/console carts:remind" and "bin/console mail:process".'|trans }}</p>
        <button type="submit" class="btn-primary">{{ 'Save cart reminder settings'|trans }}</button>
    </form>
</section>

<section class="panel">
    <h2>{{ 'Returns'|trans }}</h2>
    <form method="post" action="{{ path('admin.settings.submit') }}">
        {{ csrf_field() }}
        <input type="hidden" name="action" value="save_returns">
        <label>{{ 'Return window (days after shipping)'|trans }}
            <input type="number" name="return_window_days" value="{{ return_window_days }}" min="0" max="365" step="1" required>
        </label>
        <p class="field-hint">{{ 'Customers can request a return of shipped orders within this many days. Use 0 to turn returns off.'|trans }}</p>
        <button type="submit" class="btn-primary">{{ 'Save return settings'|trans }}</button>
    </form>
</section>

<section class="panel">
    <h2>{{ 'Invoices'|trans }}</h2>
    <form method="post" action="{{ path('admin.settings.submit') }}">
        {{ csrf_field() }}
        <input type="hidden" name="action" value="save_invoice">
        <div class="form-row">
            <label>{{ 'Company name'|trans }}
                <input type="text" name="company_name" value="{{ seller.name }}" maxlength="120">
            </label>
            <label>{{ 'VAT number'|trans }}
                <input type="text" name="company_vat_id" value="{{ seller.vat_id }}" maxlength="40" placeholder="PT123456789">
            </label>
        </div>
        <label>{{ 'Your country (EU, for VAT numbers)'|trans }}
            <input type="text" name="company_country" value="{{ seller.country }}" maxlength="40" placeholder="PT">
        </label>
        <p class="field-hint">{{ 'With VAT switched on (Tax) and your country set, EU business customers can enter a VAT number at checkout; it is checked in VIES, and VAT is not charged when they are in another EU country and the goods go there (reverse charge). Leave empty to switch this off.'|trans }}</p>
        <label>{{ 'Company address'|trans }}
            <textarea name="company_address" rows="3" maxlength="500">{{ seller.address }}</textarea>
        </label>
        <label>{{ 'Note at the bottom of invoices (optional)'|trans }}
            <textarea name="invoice_note" rows="2" maxlength="600">{{ seller.note }}</textarea>
        </label>
        <label style="display: flex; align-items: center; gap: 8px;">
            <input type="checkbox" name="invoice_attach" value="1" style="width: auto;" {{ seller.attach ? 'checked' }}>
            {{ 'Attach the invoice PDF to the payment email and the credit note to the refund email'|trans }}
        </label>
        <p class="field-hint">{{ 'Printed on the PDF invoices and credit notes that customers and staff can download for paid and refunded orders.'|trans }}</p>
        <button type="submit" class="btn-primary">{{ 'Save invoice details'|trans }}</button>
    </form>
</section>

<section class="panel">
    <h2>{{ 'Privacy and cookies'|trans }}</h2>
    <form method="post" action="{{ path('admin.settings.submit') }}">
        {{ csrf_field() }}
        <input type="hidden" name="action" value="save_privacy">
        <label style="display: flex; align-items: center; gap: 8px;">
            <input type="checkbox" name="cookie_notice" value="1" style="width: auto;" {{ privacy.notice ? 'checked' }}>
            {{ 'Show the cookie notice'|trans }}
        </label>
        <label>{{ 'Tracking snippet (loaded only after the visitor accepts)'|trans }}
            <textarea name="tracking_snippet" rows="5" maxlength="10000" placeholder="<script async src=&quot;https://…&quot;></script>" style="font-family: monospace;">{{ privacy.snippet }}</textarea>
        </label>
        <p class="field-hint">
            {{ 'The store itself only sets essential cookies. Paste an analytics or advertising snippet here and it is loaded only for visitors who click Accept; the notice then offers Accept and Decline, and is always shown.'|trans }}
        </p>
        <button type="submit" class="btn-primary">{{ 'Save privacy settings'|trans }}</button>
    </form>
</section>

<section class="panel">
    <h2>{{ 'Tax'|trans }}</h2>
    <form method="post" action="{{ path('admin.settings.submit') }}">
        {{ csrf_field() }}
        <input type="hidden" name="action" value="save_tax">
        <label style="display: flex; align-items: center; gap: 8px;">
            <input type="checkbox" name="tax_enabled" value="1" style="width: auto;" {{ tax.enabled ? 'checked' }}>
            {{ 'Charge VAT'|trans }}
        </label>
        <div class="form-row">
            <label>{{ 'Default VAT rate (%)'|trans }}
                <input type="number" name="tax_rate" value="{{ tax.rate }}" min="0" max="100" step="0.01" required>
            </label>
            <label>{{ 'Rates per country (optional)'|trans }}
                <input type="text" name="tax_country_rates" value="{{ tax.country_rates }}" maxlength="2000" placeholder="PT=23, ES=21, Germany=19">
            </label>
        </div>
        <p class="field-hint">
            {{ 'Countries are matched against what the customer types in the Country field (not case-sensitive), like shipping countries — list both the code and the name if customers might type either. Other countries use the default rate.'|trans }}
        </p>
        <label style="display: flex; align-items: center; gap: 8px;">
            <input type="checkbox" name="tax_prices_include" value="1" style="width: auto;" {{ tax.prices_include ? 'checked' }}>
            {{ 'Prices include VAT'|trans }}
        </label>
        <p class="field-hint">
            {{ 'Ticked: product prices already contain VAT — totals don\'t change and the VAT part is shown on orders. Unticked: VAT is added on top of the prices at checkout.'|trans }}
        </p>
        <label style="display: flex; align-items: center; gap: 8px;">
            <input type="checkbox" name="tax_shipping" value="1" style="width: auto;" {{ tax.shipping ? 'checked' }}>
            {{ 'Charge VAT on shipping'|trans }}
        </label>
        <p class="field-hint">{{ 'Discount codes come off the subtotal before VAT is worked out. Orders keep the rate they were placed with.'|trans }}</p>
        <button type="submit" class="btn-primary">{{ 'Save tax settings'|trans }}</button>
    </form>
</section>

<section class="panel">
    <h2>{{ 'AI prompts'|trans }}</h2>
    <p class="field-hint" style="margin-bottom: 14px;">{{ 'Keep the prompts you use to write product content here. They are stored privately on the server, not in the public site.'|trans }}</p>

    <p class="field-hint" style="margin-bottom: 14px;">
        {{ 'Reserved names replace the built-in AI prompts (.md or .txt):'|trans }}
        <code>magic-edit</code> — {{ 'AI edit of a product. Placeholders:'|trans }} <code>{instruction}</code> <code>{name}</code> <code>{short_description}</code> <code>{long_description}</code> <code>{field_json}</code>;
        <code>translate-product</code> — {{ 'product translation. Placeholders:'|trans }} <code>{language}</code> <code>{locale}</code> <code>{from}</code> <code>{from_locale}</code> <code>{name}</code> <code>{short_description}</code> <code>{long_description}</code> <code>{field_json}</code>;
        <code>magic-page</code> — {{ 'AI content for a page in Admin → Pages. Placeholders:'|trans }} <code>{page}</code> <code>{slug}</code> <code>{language}</code> <code>{store}</code> <code>{catalog}</code> <code>{instruction}</code> <code>{title}</code> <code>{body}</code>;
        <code>magic-newsletter</code> — {{ 'AI newsletter campaign. Placeholders:'|trans }} <code>{language}</code> <code>{store}</code> <code>{catalog}</code> <code>{instruction}</code> <code>{subject}</code> <code>{message}</code>.
        {{ 'Other files are just stored. Without an override the built-in prompt is used.'|trans }}
    </p>

    <form method="post" action="{{ path('admin.settings.submit') }}" enctype="multipart/form-data" data-no-ajax>
        {{ csrf_field() }}
        <input type="hidden" name="action" value="upload_prompts">
        <label class="upload-zone" data-upload-zone>
            <input type="file" name="prompts[]" accept=".md,.txt,text/markdown,text/plain" multiple required>
            <strong>{{ 'Drop prompt files here or click to choose'|trans }}</strong>
            <span class="field-hint" data-upload-zone-files>{{ '.md or .txt, up to {kb} KB each. A file with the same name is replaced.'|trans({kb: prompt_max_kb}) }}</span>
        </label>
        <button type="submit" class="btn-primary">{{ 'Upload prompts'|trans }}</button>
    </form>

    {% if prompts %}
        <table class="cart-table admin-table" style="margin-top: 18px;">
            <thead>
                <tr>
                    <th>{{ 'File'|trans }}</th>
                    <th>{{ 'Size'|trans }}</th>
                    <th>{{ 'Uploaded'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for p in prompts %}
                    <tr>
                        <td><a href="{{ path('admin.settings.prompt', {}, {file: p.name}) }}" target="_blank" rel="noopener" data-no-ajax>{{ p.name }}</a></td>
                        <td>{{ (p.size / 1024)|round(1) }} KB</td>
                        <td>{{ p.modified|date('Y-m-d H:i') }}</td>
                        <td class="table-actions">
                            <a href="{{ path('admin.settings.prompt', {}, {file: p.name, download: 1}) }}" class="btn-secondary" data-no-ajax>⬇ {{ 'Download'|trans }}</a>
                            <form method="post" action="{{ path('admin.settings.submit') }}" class="inline-form" data-no-ajax
                                  data-confirm="{{ 'Delete the prompt "{name}"?'|trans({name: p.name}) }}">
                                {{ csrf_field() }}
                                <input type="hidden" name="action" value="delete_prompt">
                                <input type="hidden" name="prompt" value="{{ p.name }}">
                                <button type="submit" class="icon-btn icon-btn-danger" title="{{ 'Delete prompt'|trans }}">🗑</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="field-hint" style="margin-top: 14px;">{{ 'No prompts uploaded yet.'|trans }}</p>
    {% endif %}
</section>

<section class="panel">
    <h2>{{ 'Themes'|trans }}</h2>
    <p class="field-hint" style="margin-bottom: 18px;">{{ 'The theme changes how the shop (and this admin panel) looks. Your products and orders aren\'t affected.'|trans }}</p>

    <div class="product-grid">
        {% for t in themes %}
            {% set active = t.slug == active_theme %}
            <div class="product-card" {% if active %}style="outline: 3px solid var(--color-accent); outline-offset: 2px;"{% endif %}>
                <div class="product-card-image">
                    {% if t.screenshot %}
                        <img src="{{ t.screenshot }}" alt="{{ '{name} preview'|trans({name: t.name}) }}" loading="lazy">
                    {% else %}
                        <div class="image-placeholder">{{ 'No preview'|trans }}</div>
                    {% endif %}
                </div>
                <div class="product-card-body">
                    <span class="category-badge">{{ t.global ? 'Global'|trans : (t.builtin ? 'Built-in'|trans : 'Uploaded'|trans) }}</span>
                    <h3>{{ t.name }}</h3>
                    {% if t.description %}<p class="short-desc">{{ t.description }}</p>{% endif %}
                    {% if not t.builtin and not t.global and (t.author or t.version) %}
                        <p class="field-hint">{{ t.author }}{{ t.author and t.version ? ' · ' }}{{ t.version ? 'v' ~ t.version }}</p>
                    {% endif %}

                    <div class="table-actions" style="margin-top: 12px;">
                        {% if active %}
                            <span class="status-badge" data-status="approved">{{ 'Active'|trans }}</span>
                        {% else %}
                            <form method="post" action="{{ path('admin.settings.submit') }}" class="inline-form" data-no-ajax>
                                {{ csrf_field() }}
                                <input type="hidden" name="action" value="activate_theme">
                                <input type="hidden" name="theme" value="{{ t.slug }}">
                                <button type="submit" class="btn-secondary">{{ 'Use this theme'|trans }}</button>
                            </form>
                            {% if not t.builtin and not t.global %}
                                <form method="post" action="{{ path('admin.settings.submit') }}" class="inline-form" data-no-ajax
                                      data-confirm="{{ 'Delete the "{name}" theme?'|trans({name: t.name}) }}">
                                    {{ csrf_field() }}
                                    <input type="hidden" name="action" value="delete_theme">
                                    <input type="hidden" name="theme" value="{{ t.slug }}">
                                    <button type="submit" class="icon-btn icon-btn-danger" title="{{ 'Delete theme'|trans }}">🗑</button>
                                </form>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</section>

<section class="panel">
    <h2>{{ 'Upload your own theme'|trans }}</h2>
    <p>
        {{ 'Start from the blank theme: it contains the folder structure, a commented stylesheet, the default Twig templates and a README explaining every file.'|trans }}
    </p>
    <p><a href="{{ path('admin.settings.blank_theme') }}" class="btn-secondary" data-no-ajax>⬇ {{ 'Download blank theme (.zip)'|trans }}</a></p>

    <form method="post" action="{{ path('admin.settings.submit') }}" enctype="multipart/form-data" data-no-ajax>
        {{ csrf_field() }}
        <input type="hidden" name="action" value="upload_theme">
        <label>{{ 'Theme .zip file'|trans }}
            <input type="file" name="theme_zip" accept=".zip,application/zip" required>
        </label>
        <label style="display: flex; align-items: center; gap: 8px;">
            <input type="checkbox" name="activate" value="1" style="width: auto;" checked> {{ 'Use it right away'|trans }}
        </label>
        <label style="display: flex; align-items: center; gap: 8px;">
            <input type="checkbox" name="replace" value="1" style="width: auto;"> {{ 'Replace a theme with the same name'|trans }}
        </label>
        <p class="field-hint">
            {{ 'Max 20 MB. Allowed: Twig templates in layout/, CSS, images, fonts and theme.json — never PHP. Templates run in a sandbox and are checked on upload.'|trans }}
        </p>
        <button type="submit" class="btn-primary">{{ 'Upload theme'|trans }}</button>
    </form>
</section>
{% endblock %}
