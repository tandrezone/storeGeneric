{% extends 'layout/admin.html.twig' %}

{% set title = 'Admin — Activity log' %}
{% set active_nav = 'activity' %}

{# Current filters, for the pagination links. #}
{% set list_query = {user: filters.username, action: filters.action, from: filters.from ?: null, to: filters.to ?: null} %}

{% block content %}
<h1>Activity log</h1>

<form method="get" action="{{ path('admin.activity') }}" class="panel" style="display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end;">
    <label>User
        <select name="user">
            <option value="">Everyone</option>
            {% for name in usernames %}
                <option value="{{ name }}" {{ filters.username == name ? 'selected' }}>{{ name }}</option>
            {% endfor %}
        </select>
    </label>
    <label>Action
        <select name="action">
            <option value="">All actions</option>
            {% for action in actions %}
                <option value="{{ action }}" {{ filters.action == action ? 'selected' }}>{{ action }}</option>
            {% endfor %}
        </select>
    </label>
    <label>From
        <input type="date" name="from" value="{{ filters.from }}">
    </label>
    <label>To
        <input type="date" name="to" value="{{ filters.to }}">
    </label>
    <button type="submit" class="btn-primary">Filter</button>
    {% if filters.username or filters.action or filters.from or filters.to %}
        <a href="{{ path('admin.activity') }}" class="btn-secondary">Clear</a>
    {% endif %}
</form>

<p class="field-hint">{{ total|number_format }} entr{{ total == 1 ? 'y' : 'ies' }}</p>

<table class="cart-table admin-table">
    <thead>
        <tr><th>When</th><th>User</th><th>Action</th><th>What</th><th>IP</th></tr>
    </thead>
    <tbody>
        {% for entry in entries %}
            <tr>
                <td class="field-hint" style="white-space: nowrap;">{{ entry.created_at }}</td>
                <td>{{ entry.username ?: '—' }}{% if entry.user_id is null and entry.username %} <span class="field-hint">(not logged in)</span>{% endif %}</td>
                <td><code>{{ entry.action }}</code></td>
                <td>
                    {{ entry.summary }}
                    {% if entry.entity_type == 'order' and entry.entity_id %}
                        · <a href="{{ path('admin.order', {id: entry.entity_id}) }}">open</a>
                    {% elseif entry.entity_type == 'product' and entry.entity_id %}
                        · <a href="{{ path('admin.products', {}, {edit: entry.entity_id}) }}">open</a>
                    {% endif %}
                    {% if entry.details_pretty %}
                        <details class="audit-details">
                            <summary class="field-hint">Details</summary>
                            <pre>{{ entry.details_pretty }}</pre>
                        </details>
                    {% endif %}
                </td>
                <td class="field-hint">{{ entry.ip_address }}</td>
            </tr>
        {% else %}
            <tr><td colspan="5" style="color: var(--color-muted);">No activity recorded{{ filters.username or filters.action or filters.from or filters.to ? ' for these filters' }}.</td></tr>
        {% endfor %}
    </tbody>
</table>

{% if total_pages > 1 %}
    <div class="pagination">
        <a href="{{ path('admin.activity', {}, list_query|merge({page: max(1, page - 1)})) }}"
           class="btn-secondary {{ page <= 1 ? 'is-disabled' }}">‹ Prev</a>
        <span class="bulk-count">Page {{ page }} of {{ total_pages }}</span>
        <a href="{{ path('admin.activity', {}, list_query|merge({page: min(total_pages, page + 1)})) }}"
           class="btn-secondary {{ page >= total_pages ? 'is-disabled' }}">Next ›</a>
    </div>
{% endif %}
{% endblock %}
