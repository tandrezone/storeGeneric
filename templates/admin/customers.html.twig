{% extends 'layout/admin.html.twig' %}

{% set title = 'Admin — Customers'|trans %}
{% set active_nav = 'customers' %}

{% set list_query = {status: filters.status, q: filters.q ?: null} %}

{% block content %}
<h1>{{ 'Customers'|trans }}</h1>

<p class="field-hint">{{ 'Storefront accounts. Guest orders aren\'t listed here — they appear under a customer only after the customer confirms the same email address. "Spent" counts paid orders that weren\'t refunded.'|trans }}</p>

<div class="filters">
    <a href="{{ path('admin.customers', {}, list_query|merge({status: null})) }}" class="filter-pill {{ filters.status is null ? 'active' }}">{{ 'All'|trans }}</a>
    {% for status in statuses %}
        <a href="{{ path('admin.customers', {}, list_query|merge({status: status})) }}" class="filter-pill {{ filters.status == status ? 'active' }}">{{ status|capitalize|trans }}</a>
    {% endfor %}
</div>

<form method="get" action="{{ path('admin.customers') }}" class="panel" style="display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end;">
    {% if filters.status %}<input type="hidden" name="status" value="{{ filters.status }}">{% endif %}
    <label style="flex: 1 1 260px;">{{ 'Search'|trans }}
        <input type="search" name="q" value="{{ filters.q }}" placeholder="{{ 'Email, name or phone'|trans }}">
    </label>
    <button type="submit" class="btn-primary">{{ 'Search'|trans }}</button>
    {% if filters.q %}
        <a href="{{ path('admin.customers', {}, {status: filters.status}) }}" class="btn-secondary">{{ 'Clear'|trans }}</a>
    {% endif %}
</form>

<p class="field-hint">{{ '{count} customer'|trans_plural(total) }}</p>

<table class="cart-table admin-table">
    <thead>
        <tr><th>{{ 'Customer'|trans }}</th><th>{{ 'Status'|trans }}</th><th>{{ 'Orders'|trans }}</th><th>{{ 'Spent'|trans }}</th><th>{{ 'Registered'|trans }}</th><th>{{ 'Last sign-in'|trans }}</th><th></th></tr>
    </thead>
    <tbody>
        {% for c in customers %}
            <tr>
                <td>
                    <strong>{{ c.name }}</strong><br>
                    <span class="field-hint">{{ c.email }}</span>
                    {% if not c.email_verified_at and not c.deleted_at %}<span class="field-hint">({{ 'not confirmed'|trans }})</span>{% endif %}
                </td>
                <td>
                    {% if c.deleted_at %}
                        <span class="status-badge" data-status="cancelled">{{ 'Deleted'|trans }}</span>
                    {% else %}
                        <span class="status-badge" data-status="{{ c.active ? 'paid' : 'cancelled' }}">{{ c.active ? 'Active'|trans : 'Inactive'|trans }}</span>
                    {% endif %}
                </td>
                <td>{{ c.order_count }}</td>
                <td>{{ c.total_spent|money }}</td>
                <td class="field-hint">{{ c.created_at|date('Y-m-d') }}</td>
                <td class="field-hint">{{ c.last_login_at ?: 'never'|trans }}</td>
                <td><a href="{{ path('admin.customer', {id: c.id}) }}" class="btn-secondary">{{ 'Open'|trans }}</a></td>
            </tr>
        {% else %}
            <tr><td colspan="7" class="field-hint">{{ 'No customers found.'|trans }}</td></tr>
        {% endfor %}
    </tbody>
</table>

{% if total_pages > 1 %}
    <div class="pagination">
        <a href="{{ path('admin.customers', {}, list_query|merge({page: max(1, page - 1)})) }}"
           class="btn-secondary {{ page <= 1 ? 'is-disabled' }}">‹ {{ 'Prev'|trans }}</a>
        <span class="bulk-count">{{ 'Page {page} of {pages}'|trans({page: page, pages: total_pages}) }}</span>
        <a href="{{ path('admin.customers', {}, list_query|merge({page: min(total_pages, page + 1)})) }}"
           class="btn-secondary {{ page >= total_pages ? 'is-disabled' }}">{{ 'Next'|trans }} ›</a>
    </div>
{% endif %}
{% endblock %}
