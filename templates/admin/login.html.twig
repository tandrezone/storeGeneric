<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin — Login</title>
<link rel="icon" href="{{ asset('images/icons/favicon.ico') }}" sizes="any">
<link rel="icon" type="image/svg+xml" href="{{ asset('images/icons/favicon.svg') }}">
<link rel="apple-touch-icon" href="{{ asset('images/icons/apple-touch-icon.png') }}">
<link rel="stylesheet" href="{{ asset('css/style.css') }}">
<style>
    .login-page { display: flex; align-items: center; justify-content: center; min-height: 80vh; }
    .login-card { width: 100%; max-width: 360px; }
</style>
</head>
<body>
<main class="container login-page">
    <div class="panel login-card">
        <span class="hero-eyebrow">{{ store.name }}</span>
        <h1 style="margin: 10px 0 20px; font-size: 1.5rem;">Admin login</h1>

        {% for flash in flashes() %}
            <p class="msg {{ flash.type == 'error' ? 'error' : '' }}">{{ flash.message }}</p>
        {% endfor %}
        {% if error %}<p class="msg error">{{ error }}</p>{% endif %}

        <form method="post" action="{{ path('admin.login.submit') }}">
            {{ csrf_field() }}
            <label>Username <input type="text" name="username" value="{{ username }}" required autofocus></label>
            <label>Password <input type="password" name="password" required></label>
            <button type="submit" class="btn-primary">Log in</button>
        </form>
    </div>
</main>
</body>
</html>
