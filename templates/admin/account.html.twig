{% extends 'layout/admin.html.twig' %}

{% set title = 'Admin — {page}'|trans({page: 'My account'|trans}) %}
{% set active_nav = 'account' %}

{% block content %}
<h1>{{ 'My account'|trans }}</h1>

{% for error in errors %}<p class="msg error">{{ error }}</p>{% endfor %}

<div class="panel">
    <p>
        {{ 'Logged in as {name}'|trans({name: '<strong>' ~ me.username|e ~ '</strong>'})|raw }}
        <span class="status-badge" data-status="{{ me.role }}">{{ me.role|capitalize|trans }}</span>
    </p>
    {% if me.email %}<p class="field-hint">{{ me.email }}</p>{% endif %}
    <p class="field-hint">{{ 'Last login: {date}. Your email and role are managed by an owner in Users.'|trans({date: me.last_login_at ?: '—'}) }}</p>
</div>

<div class="panel">
    <h2>{{ 'Language'|trans }}</h2>
    <form method="post" action="{{ path('admin.account.submit') }}" data-no-ajax>
        {{ csrf_field() }}
        <input type="hidden" name="action" value="save_language">
        <label>{{ 'Admin language'|trans }}
            <select name="locale">
                {% for language in languages() %}
                    <option value="{{ language.code }}" {{ language.code == my_locale ? 'selected' }}>{{ language.name }}</option>
                {% endfor %}
            </select>
        </label>
        <p class="field-hint">{{ 'The language of the admin panel for your account. The shop\'s default language is set in Settings.'|trans }}</p>
        <button type="submit" class="btn-primary">{{ 'Save language'|trans }}</button>
    </form>
</div>

<div class="panel">
    <h2>{{ 'Change password'|trans }}</h2>
    <form method="post" action="{{ path('admin.account.submit') }}" autocomplete="off">
        {{ csrf_field() }}
        <input type="hidden" name="action" value="change_password">
        <input type="hidden" name="username" value="{{ me.username }}" autocomplete="username">
        <label>{{ 'Current password'|trans }}
            <input type="password" name="current_password" required autocomplete="current-password">
        </label>
        <div class="form-row">
            <label>{{ 'New password'|trans }}
                <input type="password" name="new_password" required minlength="{{ min_password }}" autocomplete="new-password">
            </label>
            <label>{{ 'Repeat new password'|trans }}
                <input type="password" name="new_password_confirm" required minlength="{{ min_password }}" autocomplete="new-password">
            </label>
        </div>
        <p class="field-hint">{{ 'At least {min} characters. Your other sessions are logged out.'|trans({min: min_password}) }}</p>
        <button type="submit" class="btn-primary">{{ 'Change password'|trans }}</button>
    </form>
</div>

<div class="panel">
    <h2>{{ 'Two-factor login'|trans }}</h2>
    {% if recovery_codes %}
        <p class="msg">{{ 'Two-factor login is on. Save these recovery codes now — they are shown only once. Each one works a single time if you lose your authenticator app.'|trans }}</p>
        <pre class="field-hint" style="font-size: 1.1rem; user-select: all;">{% for code in recovery_codes %}{{ code }}
{% endfor %}</pre>
    {% elseif totp_enabled %}
        <p>{{ 'Two-factor login is on: after your password you enter a code from your authenticator app.'|trans }}</p>
        <form method="post" action="{{ path('admin.account.submit') }}" autocomplete="off" data-no-ajax>
            {{ csrf_field() }}
            <input type="hidden" name="action" value="2fa_disable">
            <div class="form-row">
                <label>{{ 'Current password'|trans }}
                    <input type="password" name="current_password" required autocomplete="current-password">
                </label>
                <label>{{ 'Code or recovery code'|trans }}
                    <input type="text" name="totp_code" required autocomplete="one-time-code" inputmode="text">
                </label>
            </div>
            <button type="submit" class="btn-danger">{{ 'Turn off two-factor login'|trans }}</button>
        </form>
    {% elseif totp_secret %}
        <p>{{ 'Add this account to an authenticator app (Google Authenticator, Authy, 1Password, …) by entering the key, or by opening the otpauth link, then type the 6-digit code it shows.'|trans }}</p>
        <p><strong>{{ 'Key'|trans }}:</strong> <code style="user-select: all;">{{ totp_secret }}</code></p>
        <p class="field-hint">{{ 'Link'|trans }}: <code style="user-select: all; word-break: break-all;">{{ totp_uri }}</code></p>
        <form method="post" action="{{ path('admin.account.submit') }}" autocomplete="off" data-no-ajax>
            {{ csrf_field() }}
            <input type="hidden" name="action" value="2fa_enable">
            <label>{{ 'Code from the app'|trans }}
                <input type="text" name="totp_code" required inputmode="numeric" pattern="[0-9 ]{6,7}" maxlength="7" autocomplete="one-time-code">
            </label>
            <button type="submit" class="btn-primary">{{ 'Confirm and turn on'|trans }}</button>
        </form>
    {% else %}
        <p>{{ 'Protect your account with a code from an authenticator app, asked after your password.'|trans }}</p>
        <form method="post" action="{{ path('admin.account.submit') }}" data-no-ajax>
            {{ csrf_field() }}
            <input type="hidden" name="action" value="2fa_start">
            <button type="submit" class="btn-primary">{{ 'Set up two-factor login'|trans }}</button>
        </form>
    {% endif %}
</div>
{% endblock %}
