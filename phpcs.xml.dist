<?xml version="1.0"?>
<ruleset name="storeGeneric">
    <description>PSR-12 coding standard for the store.</description>
    <file>src</file>
    <file>config</file>
    <file>public/index.php</file>
    <file>bin/console</file>
    <file>router.php</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12">
        <!-- Long SQL strings and Twig context arrays read better unwrapped. -->
        <exclude name="Generic.Files.LineLength"/>
    </rule>
    <!-- router.php and bin/console are scripts, not classes. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>router.php</exclude-pattern>
        <exclude-pattern>bin/console</exclude-pattern>
        <exclude-pattern>public/index.php</exclude-pattern>
        <exclude-pattern>config/*</exclude-pattern>
    </rule>
</ruleset>
