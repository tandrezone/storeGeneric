DB_HOST=localhost
DB_PORT=3306
DB_NAME=online_store
DB_USER=store_user
DB_PASS=change-me
APP_URL=https://finderskeep.online
# true shows error details and logs at debug level (var/log). Keep false in production.
APP_DEBUG=false
# Signs customer order links (confirmation / track-order pages). Generate with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# When empty, a key is generated once into var/app-secret.
APP_SECRET=

# Storefront name and active theme (a folder in public/themes/)
STORE_NAME=Finders Keep
STORE_EMAIL=support@finderskeep.online
THEME=default
# Default storefront language (a catalog in translations/: en, pt). Visitors can switch.
STORE_LANGUAGE=en
# Admin → Settings can override STORE_NAME, STORE_EMAIL, STORE_LANGUAGE and THEME.

# First admin login (there is no built-in default account). Generate a hash with:
#   php -r "echo password_hash('your-password', PASSWORD_BCRYPT), PHP_EOL;"
# Only used while the admin_users table is empty: the first login with these
# saves the account as the first Owner, then they are ignored — add and manage
# admins in Admin → Users.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Reverse proxies / load balancers in front of the app (comma-separated IPs or
# CIDR ranges, e.g. 127.0.0.1,10.0.0.0/8). Only these may set X-Forwarded-For;
# used for the admin login lockout. Leave empty when clients connect directly.
TRUSTED_PROXIES=

# ISO code; prices are shown and charged in it (JPY, KRW … have no decimals)
STORE_CURRENCY=EUR

# ------------------------------------------------------------------- email
# Order emails (confirmation, payment received, shipped, cancelled/refunded)
# and the admin new-order alert.
# MAIL_TRANSPORT: smtp | mail (PHP mail()/sendmail) | log (default: writes to var/log/mail-*.log)
MAIL_TRANSPORT=log
MAIL_HOST=
# 587 for tls (STARTTLS), 465 for ssl
MAIL_PORT=587
# tls | ssl | none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
# Sender; defaults to STORE_EMAIL / STORE_NAME
MAIL_FROM=
MAIL_FROM_NAME=
# Where new-order alerts go; defaults to the store email
ADMIN_NOTIFY_EMAIL=

# ---------------------------------------------------------------- payments
# Turn each method on/off with PAYMENT_<METHOD>_ENABLED=true|false.
# A method only appears at checkout when it is enabled AND its required
# settings (marked "required") are filled in.

# Stripe (cards, Apple Pay, Google Pay) — webhook: /payment/stripe-webhook.php
PAYMENT_STRIPE_ENABLED=false
# required — sk_test_… / sk_live_…
STRIPE_SECRET_KEY=
# required — whsec_…
STRIPE_WEBHOOK_SECRET=

# PayPal — return URL handled by /payment/paypal-return.php
PAYMENT_PAYPAL_ENABLED=false
# required
PAYPAL_CLIENT_ID=
# required
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# Revolut Pay (Revolut Business merchant account) — webhook: /payment/revolut-webhook.php
PAYMENT_REVOLUT_ENABLED=false
# required
REVOLUT_SECRET_KEY=
# required — signing secret returned when the webhook is created
REVOLUT_WEBHOOK_SECRET=
REVOLUT_SANDBOX=true
REVOLUT_API_VERSION=2026-08-17

# OxaPay (crypto) — webhook: /payment/callback.php
PAYMENT_OXAPAY_ENABLED=false
# required
OXAPAY_MERCHANT_KEY=
OXAPAY_SANDBOX=true

# Bank transfer (admin marks orders paid by hand)
PAYMENT_BANK_TRANSFER_ENABLED=false
# required
BANK_ACCOUNT_NAME=
# required
BANK_IBAN=
BANK_BIC=
BANK_NAME=

# Cash on delivery (admin marks orders paid by hand)
PAYMENT_COD_ENABLED=false
COD_NOTE=Please have the exact amount ready when the courier arrives.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=
